                <zone forceUpdate='true' friendly-name='Busiest Hours &amp; Weeks' h='40618' id='73' type-v2='text' w='20082' x='562' y='15789'>
                  <formatted-text>
                    <run>Æ&#10;</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run bold='true' fontalignment='1' fontcolor='#f28e2b'>REVENUE LEADERS</run>
                    <run fontalignment='1'>&#10;Premium </run>
                    <run fontalignment='1' fontcolor='#8cd17d'>chicken pizzas</run>
                    <run fontalignment='1'> drive maximum total revenue, led by </run>
                    <run fontalignment='1' fontcolor='#8cd17d'>Thai Chicken</run>
                    <run fontalignment='1'>.&#10;&#10;</run>
                    <run bold='true' fontalignment='1' fontcolor='#f28e2b'>VOLUME CHAMPIONS</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run fontalignment='1' fontcolor='#8cd17d'>Classic Deluxe</run>
                    <run fontalignment='1'> leads in total units sold, acting as the main volume driver.

</run>
                    <run bold='true' fontalignment='1' fontcolor='#f28e2b'>LOWEST PERFORMERS</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run fontalignment='1' fontcolor='#e15759'>Brie Carre</run>
                    <run fontalignment='1'> generates both the </run>
                    <run fontalignment='1' fontcolor='#ff9da7'>lowest revenue </run>
                    <run fontalignment='1'>and </run>
                    <run fontalignment='1' fontcolor='#ff9da7'>lowest quantity </run>
                    <run fontalignment='1'>across the menu.&#10;&#10;</run>
                    <run bold='true' fontalignment='1' fontcolor='#f28e2b'>PRICE &amp; VOLUME</run>
                    <run fontalignment='1'>&#10;High-priced pizzas like </run>
                    <run fontalignment='1' fontcolor='#8cd17d'>Thai Chicken  </run>
                    <run fontalignment='1'>drive strong revenue despite lower unit sales, while budget-friendly options like </run>
                    <run fontalignment='1' fontcolor='#8cd17d'>Classic Deluxe</run>
                    <run fontalignment='1'> fuel overall volume through frequent orders.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#898989' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='2' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
