                  <zone forceUpdate='true' friendly-name='Busiest Hours &amp; Weeks' h='40618' id='73' type-v2='text' w='20082' x='562' y='15789'>
                    <formatted-text>
                      <run>Æ&#10;</run>
                      <run fontalignment='1'>Æ&#10;</run>
                      <run bold='true' fontalignment='1' fontcolor='#f28e2b'>REVENUE LEADERS</run>
                      <run fontalignment='1'>&#10;Premium </run>
                      <run fontalignment='1' fontcolor='#8cd17d'>chicken pizzas</run>
                      <run fontalignment='1'> drive maximum total revenue, led by </run>
                      <run fontalignment='1' fontcolor='#8cd17d'>Thai Chicken</run>
                      <run fontalignment='1'>.&#10;&#10;</run>
                      <run bold='true' fontalignment='1' fontcolor='#f28e2b'>VOLUME CHAMPIONS</run>
                      <run fontalignment='1'>Æ&#10;</run>
                      <run fontalignment='1' fontcolor='#8cd17d'>Classic Deluxe</run>
                      <run fontalignment='1'> leads in total units sold, acting as the main volume driver.

</run>
                      <run bold='true' fontalignment='1' fontcolor='#f28e2b'>LOWEST PERFORMERS</run>
                      <run fontalignment='1'>Æ&#10;</run>
                      <run fontalignment='1' fontcolor='#e15759'>Brie Carre</run>
                      <run fontalignment='1'> generates both the </run>
                      <run fontalignment='1' fontcolor='#ff9da7'>lowest revenue </run>
                      <run fontalignment='1'>and </run>
                      <run fontalignment='1' fontcolor='#ff9da7'>lowest quantity </run>
                      <run fontalignment='1'>across the menu.&#10;&#10;</run>
                      <run bold='true' fontalignment='1' fontcolor='#f28e2b'>PRICE &amp; VOLUME</run>
                      <run fontalignment='1'>&#10;High-priced pizzas like </run>
                      <run fontalignment='1' fontcolor='#8cd17d'>Thai Chicken  </run>
                      <run fontalignment='1'>drive strong revenue despite lower unit sales, while budget-friendly options like </run>
                      <run fontalignment='1' fontcolor='#8cd17d'>Classic Deluxe</run>
                      <run fontalignment='1'> fuel overall volume through frequent orders.</run>
                    </formatted-text>
                    <zone-style>
                      <format attr='border-color' value='#898989' />
                      <format attr='border-style' value='solid' />
                      <format attr='border-width' value='2' />
                      <format attr='margin' value='4' />
                    </zone-style>
                  </zone>
                  <zone forceUpdate='true' h='42678' id='75' type-v2='text' w='20082' x='562' y='56407'>
                    <formatted-text>
                      <run>Æ&#10;</run>
                      <run fontalignment='1'>Æ&#10;</run>
                      <run bold='true' fontalignment='1' fontcolor='#f28e2b'>MENU PRICING</run>
                      <run fontalignment='1'>
Consider removing or replacing </run>
                      <run fontalignment='1' fontcolor='#edc948'>bottom sellers</run>
                      <run fontalignment='1'> like </run>
                      <run fontalignment='1' fontcolor='#e15759'>Brie Carre </run>
                      <run fontalignment='1'>to </run>
                      <run fontalignment='1' fontcolor='#f1ce63'>reduce</run>
                      <run fontalignment='1' fontcolor='#ff9da7'> ingredient waste</run>
                      <run fontalignment='1'> and </run>
                      <run fontalignment='1' fontcolor='#f1ce63'>simplify</run>
                      <run fontalignment='1' fontcolor='#ff9da7'> kitchen operations</run>
                      <run fontalignment='1'>.&#10;&#10;</run>
                      <run bold='true' fontalignment='1' fontcolor='#f28e2b'>HERO PRODUCT MARKETING</run>
                      <run fontalignment='1'>&#10;Feature </run>
                      <run fontalignment='1' fontcolor='#f1ce63'>top revenue</run>
                      <run fontalignment='1'> (</run>
                      <run fontalignment='1' fontcolor='#8cd17d'>Thai Chicken</run>
                      <run fontalignment='1'>) and</run>
                      <run fontalignment='1' fontcolor='#f1ce63'> volume drivers </run>
                      <run fontalignment='1'>(</run>
                      <run fontalignment='1' fontcolor='#8cd17d'>Classic Deluxe</run>
                      <run fontalignment='1'>) on </run>
                      <run fontalignment='1' fontcolor='#ff9da7'>app banners </run>
                      <run fontalignment='1'>and </run>
                      <run fontalignment='1' fontcolor='#ff9da7'>physical menus </run>
                      <run fontalignment='1'>to maximize conversions.&#10;&#10;</run>
                      <run bold='true' fontalignment='1' fontcolor='#f28e2b'>COMBO BUNDELING</run>
                      <run fontalignment='1'>&#10;Pair </run>
                      <run fontalignment='1' fontcolor='#f1ce63'>high-volume sellers</run>
                      <run fontalignment='1'> like </run>
                      <run fontalignment='1' fontcolor='#8cd17d'>Classic Deluxe</run>
                      <run fontalignment='1'> with drinks or sides to </run>
                      <run fontalignment='1' fontcolor='#ff9da7'>push overall AOV</run>
                      <run fontalignment='1'> higher.&#10;&#10;</run>
                      <run bold='true' fontalignment='1' fontcolor='#f28e2b'>INGREDIENT OPTIMIZATION</run>
                      <run fontalignment='1'>&#10;Shift </run>
                      <run fontalignment='1' fontcolor='#ff9da7'>inventory stocking </run>
                      <run fontalignment='1'>towards</run>
                      <run fontalignment='1' fontcolor='#f1ce63'> high-frequency pizzas</run>
                      <run fontalignment='1'> like </run>
                      <run fontalignment='1' fontcolor='#8cd17d'>Classic Deluxe</run>
                      <run fontalignment='1'> to</run>
                      <run fontalignment='1' fontcolor='#ff9da7'> prevent stockouts</run>
                      <run fontalignment='1'> during peak rushes.</run>
                    </formatted-text>
                    <zone-style>
                      <format attr='border-color' value='#898989' />
                      <format attr='border-style' value='solid' />
                      <format attr='border-width' value='2' />
                      <format attr='margin' value='4' />
                    </zone-style>
                  </zone>
