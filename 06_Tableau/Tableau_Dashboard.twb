                </zone>
                <zone forceUpdate='true' friendly-name='Busiest Hours &amp; Weeks' h='48627' id='73' type-v2='text' w='20084' x='562' y='15789'>
                  <formatted-text>
                    <run>Æ&#10;&#10;</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run bold='true' fontalignment='1' fontcolor='#f28e2b' fontsize='8'>HOURLY TREND</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run fontalignment='1' fontsize='8'>Orders spike sharply during</run>
                    <run fontalignment='1' fontcolor='#8cd17d' fontsize='8'> Lunch (12–2 PM)</run>
                    <run fontalignment='1' fontsize='8'> and </run>
                    <run fontalignment='1' fontcolor='#8cd17d' fontsize='8'>Dinner (4–8 PM)</run>
                    <run fontalignment='1' fontsize='8'>.</run>
                    <run fontalignment='1'>Æ&#10;&#10;</run>
                    <run bold='true' fontalignment='1' fontcolor='#f28e2b' fontsize='8'>DAILY TREND</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run fontalignment='1' fontcolor='#8cd17d' fontsize='8'>Thursday </run>
                    <run fontalignment='1' fontsize='8'>and </run>
                    <run fontalignment='1' fontcolor='#8cd17d' fontsize='8'>Friday</run>
                    <run fontalignment='1' fontsize='8'> record the highest weekly order volume.</run>
                    <run fontalignment='1'>Æ&#10;&#10;</run>
                    <run bold='true' fontalignment='1' fontcolor='#f28e2b' fontsize='8'>MONTHLY VOLUME</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run fontalignment='1' fontsize='8'>Sales remain</run>
                    <run fontalignment='1' fontcolor='#ff9da7' fontsize='8'> steady year-round</run>
                    <run fontalignment='1' fontsize='8'>, with peak revenue in </run>
                    <run fontalignment='1' fontcolor='#8cd17d' fontsize='8'>May</run>
                    <run fontalignment='1' fontsize='8'> and </run>
                    <run fontalignment='1' fontcolor='#8cd17d' fontsize='8'>July</run>
                    <run fontalignment='1' fontsize='8'>.</run>
                    <run fontalignment='1'>Æ&#10;&#10;</run>
                    <run bold='true' fontalignment='1' fontcolor='#f28e2b' fontsize='8'>AOV HIGHLIGHT</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run fontalignment='1' fontcolor='#8cd17d' fontsize='8'>November</run>
                    <run fontalignment='1' fontsize='8'> achieved the highest </run>
                    <run fontalignment='1' fontcolor='#f1ce63' fontsize='8'>Average Order Value</run>
                    <run fontalignment='1' fontsize='8'> despite </run>
                    <run fontalignment='1' fontcolor='#ff9da7' fontsize='8'>moderate order volume</run>
                    <run fontalignment='1' fontsize='8'>.</run>
                    <run fontalignment='1'>Æ&#10;&#10;</run>
                    <run bold='true' fontalignment='1' fontcolor='#f28e2b' fontsize='8'>CATEGORY SHARE</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run fontalignment='1' fontsize='8'>Sales are</run>
                    <run fontalignment='1' fontcolor='#f1ce63' fontsize='8'> well-balanced</run>
                    <run fontalignment='1' fontsize='8'> across all categories, with</run>
                    <run fontalignment='1' fontcolor='#8cd17d' fontsize='8'> Classic</run>
                    <run fontalignment='1' fontsize='8'> leading total revenue.</run>
                    <run fontalignment='1'>Æ&#10;&#10;</run>
                    <run bold='true' fontalignment='1' fontcolor='#f28e2b' fontsize='8'>SIZE PREFERENCE</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run fontalignment='1' fontcolor='#8cd17d' fontsize='8'>Large (L)</run>
                    <run fontalignment='1' fontsize='8'> size is the top-selling pizza across the board.</run>
                    <run fontalignment='1'>Æ&#10;&#10;</run>
                    <run bold='true' fontalignment='1' fontcolor='#f28e2b' fontsize='8'>NICHE SIZES</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run fontalignment='1' fontcolor='#ff0000' fontsize='8'>XL</run>
                    <run fontalignment='1' fontsize='8'> &amp; </run>
                    <run fontalignment='1' fontcolor='#ff0000' fontsize='8'>XXL</run>
                    <run fontalignment='1' fontsize='8'> sizes account for </run>
                    <run fontalignment='1' fontcolor='#ff0000' fontsize='8'>&lt; 2%</run>
                    <run fontalignment='1' fontsize='8'> of total sales combined and exist exclusively in the </run>
                    <run fontalignment='1' fontcolor='#ff0000' fontsize='8'>Classic</run>
                    <run fontalignment='1' fontsize='8'> category.</run>
                    <run fontalignment='1'>Æ&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#898989' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='2' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='34669' id='75' type-v2='text' w='20084' x='562' y='64416'>
                  <formatted-text>
                    <run>Æ&#10;</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run bold='true' fontalignment='1' fontcolor='#f28e2b' fontsize='8'>SHIFT MANAGEMENT</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run fontalignment='1' fontsize='8'>Align </run>
                    <run fontalignment='1' fontcolor='#f1ce63' fontsize='8'>kitchen staff </run>
                    <run fontalignment='1' fontsize='8'>and</run>
                    <run fontalignment='1' fontcolor='#f1ce63' fontsize='8'> delivery schedules</run>
                    <run fontalignment='1' fontsize='8'> around </run>
                    <run fontalignment='1' fontcolor='#8cd17d' fontsize='8'>12–2 PM</run>
                    <run fontalignment='1' fontsize='8'> and </run>
                    <run fontalignment='1' fontcolor='#8cd17d' fontsize='8'>4–8 PM</run>
                    <run fontalignment='1' fontsize='8'> peak windows (especially </run>
                    <run fontalignment='1' fontcolor='#8cd17d' fontsize='8'>Thu–Fri</run>
                    <run fontalignment='1' fontsize='8'>) to reduce order fulfillment time.</run>
                    <run fontalignment='1'>Æ&#10;&#10;</run>
                    <run bold='true' fontalignment='1' fontcolor='#f28e2b' fontsize='8'>AOV REPLICATION</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run fontalignment='1' fontcolor='#f1ce63' fontsize='8'>Analyze and replicate </run>
                    <run fontalignment='1' fontcolor='#8cd17d' fontsize='8'>November</run>
                    <run fontalignment='1' fontsize='8'>&apos;s </run>
                    <run fontalignment='1' fontcolor='#f1ce63' fontsize='8'>bundle/upsell strategy</run>
                    <run fontalignment='1' fontsize='8'> across</run>
                    <run fontalignment='1' fontcolor='#8cd17d' fontsize='8'> other months</run>
                    <run fontalignment='1' fontsize='8'> to boost order values year-round.</run>
                    <run fontalignment='1'>Æ&#10;&#10;</run>
                    <run bold='true' fontalignment='1' fontcolor='#f28e2b' fontsize='8'>CORE PRODUCT FOCUS</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run fontalignment='1' fontsize='8'>Feature </run>
                    <run fontalignment='1' fontcolor='#8cd17d' fontsize='8'>Large Classic combo deals</run>
                    <run fontalignment='1' fontsize='8'> on app banners and menus to </run>
                    <run fontalignment='1' fontcolor='#f1ce63' fontsize='8'>maximize high-converting sales</run>
                    <run fontalignment='1' fontsize='8'>.</run>
                    <run fontalignment='1'>Æ&#10;&#10;</run>
                    <run bold='true' fontalignment='1' fontcolor='#f28e2b' fontsize='8'>MENU RATIONALIZATION</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run fontalignment='1' fontsize='8'>Re-evaluate </run>
                    <run fontalignment='1' fontcolor='#ff0000' fontsize='8'>XL </run>
                    <run fontalignment='1' fontsize='8'>&amp; </run>
                    <run fontalignment='1' fontcolor='#ff0000' fontsize='8'>XXL</run>
                    <run fontalignment='1' fontsize='8'> offerings—either </run>
                    <run fontalignment='1' fontcolor='#8cd17d' fontsize='8'>discontinue</run>
                    <run fontalignment='1' fontsize='8'> them to</run>
                    <run fontalignment='1' fontcolor='#f1ce63' fontsize='8'> simplify box inventory and kitchen prep</run>
                    <run fontalignment='1' fontsize='8'>, or test </run>
                    <run fontalignment='1' fontcolor='#8cd17d' fontsize='8'>expanding them </run>
                    <run fontalignment='1' fontsize='8'>to </run>
                    <run fontalignment='1' fontcolor='#f1ce63' fontsize='8'>Veggie </run>
                    <run fontalignment='1' fontsize='8'>and </run>
                    <run fontalignment='1' fontcolor='#f1ce63' fontsize='8'>Chicken </run>
                    <run fontalignment='1' fontsize='8'>categories.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#898989' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='2' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
              </zone>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
